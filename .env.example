# このファイルを .env.local にコピーして、Supabase の値を入れてください。
# Project Settings → API にある Project URL と、公開キー（publishable key。古い画面では anon public key）です。
# （.env.local は Git に入らないように、.gitignore で除外されています）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
